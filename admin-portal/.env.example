# CampusDesk Backend Server URL
VITE_API_URL=http://localhost:5000

# Google OAuth 2.0 Web Client ID (Admin Portal Console)
# How to get this value:
# 1. Open Google Cloud Console: https://console.cloud.google.com/
# 2. Go to APIs & Services -> Credentials
# 3. Use the same "Web application" OAuth client or create a dedicated one
# 4. Under "Authorized JavaScript origins", add: http://localhost:5173
# 5. Under "Authorized redirect URIs", add: http://localhost:5173
# 6. Copy the Client ID (format: <id>.apps.googleusercontent.com)
VITE_GOOGLE_CLIENT_ID=your_client_id.apps.googleusercontent.com
