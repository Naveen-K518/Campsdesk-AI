PORT=5000
NODE_ENV=development
JWT_SECRET=your_jwt_secret_key_here
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.8-flash

# Google OAuth 2.0 Web Client ID (Backend Server-Side Token Verification)
# How to get this value:
# 1. Open Google Cloud Console: https://console.cloud.google.com/
# 2. Go to APIs & Services -> Credentials
# 3. Copy the Client ID from your "Web application" OAuth client
# 4. The server uses this ID to verify that tokens were issued specifically for this app
GOOGLE_WEB_CLIENT_ID=your_client_id.apps.googleusercontent.com

# Optional Native Client IDs (For verifying tokens issued from Android/iOS native clients)
GOOGLE_ANDROID_CLIENT_ID=
GOOGLE_IOS_CLIENT_ID=

# Domain restrictions and signup policies
ALLOWED_EMAIL_DOMAINS=campus.edu,bitsathy.ac.in
ALLOW_STUDENT_AUTO_SIGNUP=false

# Authentication Flags
ENABLE_PASSWORD_AUTH=true
MAX_MENTEES_PER_MENTOR=20
