# CampusDesk Backend Server URL
EXPO_PUBLIC_API_URL=http://localhost:5000

# Google OAuth 2.0 Web Client ID (Frontend Expo Web & Expo Go)
# How to get this value:
# 1. Open Google Cloud Console: https://console.cloud.google.com/
# 2. Go to APIs & Services -> Credentials
# 3. Click "+ CREATE CREDENTIALS" -> "OAuth client ID"
# 4. Select Application type: "Web application"
# 5. Add Authorized JavaScript Origin: http://localhost:8081
# 6. Add Authorized Redirect URI: http://localhost:8081
# 7. Copy the generated Client ID (format: <id>.apps.googleusercontent.com)
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=your_client_id.apps.googleusercontent.com

# Optional Native Client IDs (Only needed for standalone Android/iOS native builds)
EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=
